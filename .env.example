# Settings of the assistant in the web app (app/streamlit_app.py). Copy this file to .env and
# edit it; .env is ignored by git. Everything is optional: with no .env at all the app looks
# for a local Ollama server with the llama3.2 model, and it works without the assistant.

# ollama | gemini | groq   (unset: gemini or groq when its key is set below, else ollama)
LLM_PROVIDER=ollama

# Local, free: install Ollama (https://ollama.com), then `ollama pull llama3.2` once.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud, with your own key (both offer a free tier with rate limits at the time of writing).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
